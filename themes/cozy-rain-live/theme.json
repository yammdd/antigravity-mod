{
  "name": "Cyberpunk Rain Room",
  "author": "Community Live Wallpapers",
  "version": "1.0.0",
  "category": "video",
  "source": "https://github.com/usman-369/wallpapers",
  "description": "Animated looping video looking out over a rainy neon skyline from a dark quiet cabin.",
  "targets": [
    "ide",
    "app",
    "cli"
  ],
  "preview": "./assets/poster.jpg",
  "backdrop": {
    "file": "./assets/backdrop.webm"
  },
  "cliBackdrop": "./assets/terminal.gif",
  "preset": {
    "colorMode": "dark",
