    "wallpaperBlur": 0,
    "sidebarOpacity": 56,
    "editorOpacity": 64,
    "chatOpacity": 58,
    "tabsStyle": "default",
    "cornerRadius": 10
  },
  "cli": {
    "colorScheme": "tokyo night",
    "runningLightSpeed": "slow",
    "statusLinePreset": "powerline"
  }
}
