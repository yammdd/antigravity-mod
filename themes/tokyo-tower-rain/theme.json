{
  "name": "Tokyo Tower Night (4K)",
  "author": "Wallhaven Photography",
  "version": "2.0.0",
  "category": "landscape",
  "source": "https://wallhaven.cc/w/wy6vqx",
  "description": "4K UHD night panorama of illuminated Tokyo Tower and city skyline under a starry midnight sky.",
  "targets": [
    "ide",
